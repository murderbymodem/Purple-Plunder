<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>Library</OutputType>
    <AssemblyOriginatorKeyFile>BrainySoftware.snk</AssemblyOriginatorKeyFile>
    <LangVersion>14</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- WebClient is obsolete but fully supported in .NET 10. Moving the Twitch API and download code
         to HttpClient is a separate refactor; until then this warning is expected. -->
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\GlobalAssemblyInfo.cs">
      <Link>GlobalAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- Fetched by scripts/get-ffmpeg.ps1. On Linux the ffmpeg on the PATH is used. -->
    <None Include="..\Libraries\ffmpeg.exe" Condition="Exists('..\Libraries\ffmpeg.exe')">
      <Link>ffmpeg.exe</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <!-- Keep ffmpeg.exe next to the executable when publishing as a single file -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PurplePlunder.Core\PurplePlunder.Core.csproj" />
    <ProjectReference Include="..\PurplePlunder.Shared\PurplePlunder.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop">
      <Version>11.3.11</Version>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json">
      <Version>13.0.5-beta1</Version>
    </PackageReference>
    <PackageReference Include="Ninject">
      <Version>4.0.0-beta.1</Version>
    </PackageReference>
  </ItemGroup>
</Project>